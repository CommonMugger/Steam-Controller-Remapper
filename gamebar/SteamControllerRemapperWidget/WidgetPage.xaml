<Page
    x:Class="SteamControllerRemapperWidget.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Enabled"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled"
                  ZoomMode="Disabled">
        <StackPanel Padding="16" Spacing="12">
            <TextBlock Text="Steam Controller Remapper" FontSize="22" FontWeight="SemiBold" />

            <StackPanel Spacing="4">
                <TextBlock x:Name="ActiveProfileTextBlock" Text="Active profile: -" />
                <TextBlock x:Name="DetectedGameTextBlock" Text="Detected game: -" />
                <TextBlock x:Name="BatteryTextBlock" Text="" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock x:Name="StatusTextBlock" Text="Connecting..." Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="WrapWholeWords" />
            </StackPanel>

            <CheckBox x:Name="AutoSwitchCheckBox" Content="Auto-switch profiles when game launches" Click="AutoSwitchCheckBox_Click" />

            <StackPanel Spacing="8">
                <TextBlock Text="Installed game / profile" />
                <ComboBox x:Name="ProfilesComboBox"
                          MinWidth="240"
                          HorizontalAlignment="Stretch"
                          DropDownOpened="ComboBox_DropDownOpened"
                          DropDownClosed="ComboBox_DropDownClosed"
                          SelectionChanged="ProfilesComboBox_SelectionChanged" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Quick gamepad remaps" />

                <TextBlock Text="BACK PADDLES" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                <Grid ColumnSpacing="8" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="L4" />
                    <ComboBox x:Name="L4ComboBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="L5" />
                    <ComboBox x:Name="L5ComboBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="R4" />
                    <ComboBox x:Name="R4ComboBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="R5" />
                    <ComboBox x:Name="R5ComboBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                    <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="QAM" />
                    <ComboBox x:Name="QamComboBox" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                </Grid>

                <TextBlock Text="FACE BUTTONS" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                <Grid ColumnSpacing="8" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="A" />
                    <ComboBox x:Name="AComboBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="B" />
                    <ComboBox x:Name="BComboBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="X" />
                    <ComboBox x:Name="XComboBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Y" />
                    <ComboBox x:Name="YComboBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                </Grid>

                <TextBlock Text="BUMPERS" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                <Grid ColumnSpacing="8" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="LB" />
                    <ComboBox x:Name="LbComboBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="RB" />
                    <ComboBox x:Name="RbComboBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                </Grid>

                <TextBlock Text="TRIGGERS" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                <Grid ColumnSpacing="8" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="L2" />
                    <ComboBox x:Name="L2ComboBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="R2" />
                    <ComboBox x:Name="R2ComboBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                </Grid>

                <TextBlock Text="STICKS" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                <Grid ColumnSpacing="8" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="L3" />
                    <ComboBox x:Name="L3ComboBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="R3" />
                    <ComboBox x:Name="R3ComboBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                </Grid>

                <TextBlock Text="D-PAD" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                <Grid ColumnSpacing="8" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Up" />
                    <ComboBox x:Name="DpadUpComboBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Down" />
                    <ComboBox x:Name="DpadDownComboBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Left" />
                    <ComboBox x:Name="DpadLeftComboBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Right" />
                    <ComboBox x:Name="DpadRightComboBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                </Grid>

                <TextBlock Text="SYSTEM" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                <Grid ColumnSpacing="8" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="View" />
                    <ComboBox x:Name="ViewComboBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Menu" />
                    <ComboBox x:Name="MenuComboBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Guide" />
                    <ComboBox x:Name="GuideComboBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                              DropDownOpened="ComboBox_DropDownOpened" DropDownClosed="ComboBox_DropDownClosed"
                              SelectionChanged="BindingComboBox_SelectionChanged" />
                </Grid>

                <TextBlock x:Name="BindingsHelpTextBlock"
                           Text="Selecting a button here will overwrite any key chord or macro on that button."
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                           TextWrapping="WrapWholeWords" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Spacing="8">
                <Button Content="Open Desktop Editor"
                        HorizontalAlignment="Stretch"
                        Click="OpenDesktopEditorButton_Click" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Refresh" Click="RefreshButton_Click" />
                    <Button Content="Refresh Library" Click="RefreshLibraryButton_Click" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
